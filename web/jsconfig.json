{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "checkJs": true,
    "allowJs": true,
    "strict": true
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "vite.config.js"]
}
