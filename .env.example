# Test/dev config for the (not-yet-written) automated API test suite - see
# docs/todo.md "API testing approach". Copy this to .env (already
# gitignored) and fill in real values - never commit the real .env.
#
# Deliberately NOT pre-filled with current values here, even though
# pool/client/API IDs aren't secret (see docs/architecture.md §5) - this
# file is a template, not a live mirror, so it can't go stale. Current
# values are the "Live stack outputs" in docs/todo.md - that's the one
# source of truth; copy from there, don't duplicate here.

AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_BASE_URL=

# Test user - created via admin-create-user, not the real signup flow
# (see docs/todo.md "Manual test user").
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Shared invite code gating self-signup - the PreSignUp Lambda trigger
# rejects any registration that doesn't present it (docs/todo.md's security
# review, finding H-1). Read directly from .env by infra/'s SmallstashStack
# at synth time, so `cdk deploy` needs no extra flags; the synth hard-fails
# if this is unset rather than deploying an ungated signup endpoint.
# Treat it as a real secret: anyone holding it can create an account.
SMALLSTASH_INVITE_CODE=

# web/ (Vite PWA client) reads these same four vars above directly - no
# VITE_-prefixed duplicates needed. web/vite.config.js explicitly whitelists
# just AWS_REGION/COGNITO_USER_POOL_ID/COGNITO_CLIENT_ID/API_BASE_URL into
# the client bundle via `define`, so nothing else in this file (including
# TEST_USER_PASSWORD) can leak into shipped JS.
