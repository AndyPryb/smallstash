<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>andriy.prybaten</groupId>
  <artifactId>files-lambda</artifactId>
  <version>0.1</version>
  <packaging>${packaging}</packaging>

  <!--
    The second Lambda from docs/file-storage-plan.md sec 3a - sibling to
    vault-lambda, same shape (Micronaut app -> shaded Lambda jar), deployed
    behind the same HttpApi/Cognito authorizer but with its own execution
    role, own S3 bucket, and zero DynamoDB access. Structured as close to
    vault-lambda/pom.xml as the dependency set allows, on purpose - anyone
    reading one should recognise the other.
  -->
  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <version>5.1.0</version>
  </parent>

  <properties>
    <packaging>jar</packaging>
    <jdk.version>25</jdk.version>
    <release.version>25</release.version>
    <micronaut.version>5.1.0</micronaut.version>
    <micronaut.runtime>lambda</micronaut.runtime>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>

  <dependencies>

    <dependency>
      <groupId>andriy.prybaten</groupId>
      <artifactId>common</artifactId>
      <version>0.1</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-events</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-apigateway</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-lambda-events-serde</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-function-aws</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Same reasoning as vault-lambda: routes API Gateway events to normal
         @Controller classes, and its MicronautLambdaAuthenticationFetcher is
         what turns HttpApi's Cognito JWT authorizer claims into a Micronaut
         Authentication with zero bespoke code - see
         docs/file-storage-plan.md sec 3a. -->
    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-function-aws-api-proxy</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Defense-in-depth in-Lambda JWT re-check, same as vault-lambda - see
         docs/file-storage-plan.md sec 3a on why this is config/dependency
         duplication only (nothing bespoke), not a maintenance risk. -->
    <dependency>
      <groupId>io.micronaut.security</groupId>
      <artifactId>micronaut-security-jwt</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.crac</groupId>
      <artifactId>micronaut-crac</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.serde</groupId>
      <artifactId>micronaut-serde-jackson</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Storage: S3 only - no DynamoDB dependency at all, matching the IAM
         decision in docs/file-storage-plan.md sec 8.5 (this Lambda has zero
         DynamoDB access; the files index is an S3 blob, not a table row). -->
    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-sdk-v2</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Presigned POST generation for direct browser-to-S3 uploads - see
         docs/file-storage-plan.md sec 3, "why not through the Lambda". Not a
         vault-lambda dependency; files-lambda is the only Lambda that ever
         signs a URL rather than reading/writing bytes itself. -->
    <!-- No separate s3-presigner dependency: S3Presigner ships inside the s3
         artifact itself in this SDK version (2.48.3) - confirmed by checking
         the actual jar contents rather than assumed. An explicit
         `s3-presigner` coordinate was tried first and failed to resolve
         (that artifact existed in older SDK v2 releases, apparently folded
         into `s3` core since); worth knowing if this ever needs revisiting
         against a different SDK version. -->


    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.test</groupId>
      <artifactId>micronaut-test-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Local dev/test: LocalStack S3 only - no DynamoDB test resource
         module, mirroring the "no DynamoDB at all" IAM decision above. -->
    <dependency>
      <groupId>io.micronaut.testresources</groupId>
      <artifactId>micronaut-test-resources-localstack-s3</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.micronaut.maven</groupId>
        <artifactId>micronaut-maven-plugin</artifactId>
        <configuration>
          <configurationValidation>
            <enabled>false</enabled>
            <suppressions>
              <suppression>datasources.default.db-type</suppression>
            </suppressions>
            <failOnNotPresent>true</failOnNotPresent>
            <validateDependencyInjection>false</validateDependencyInjection>
            <cacheEnabled>true</cacheEnabled>
          </configurationValidation>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>io.micronaut.serde</groupId>
              <artifactId>micronaut-serde-processor</artifactId>
              <version>${micronaut.serialization.version}</version>
              <exclusions>
                <exclusion>
                  <groupId>io.micronaut</groupId>
                  <artifactId>micronaut-inject</artifactId>
                </exclusion>
              </exclusions>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amicronaut.processing.group=andriy.prybaten</arg>
            <arg>-Amicronaut.processing.module=files-lambda</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
