<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>andriy.prybaten</groupId>
  <artifactId>vault-lambda</artifactId>
  <version>0.1</version>
  <packaging>${packaging}</packaging>

  <!--
    Renamed from "smallstash" (which now names the aggregator at the repo
    root - see ../pom.xml) as part of the Phase 0.5 restructuring in
    docs/file-storage-plan.md: this is the vault/keys Lambda, sibling to the
    new files-lambda coming in Phase 1. Everything below is otherwise
    unchanged from before the restructuring - same parent, same properties,
    same dependencies plus one new one (common, immediately below) - the
    goal was a zero-behaviour-change refactor, verified by build/jar-content
    comparison, not a redesign.
  -->
  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <version>5.1.5</version>
  </parent>

  <properties>
    <packaging>jar</packaging>
    <jdk.version>25</jdk.version>
    <release.version>25</release.version>
    <micronaut.version>5.1.0</micronaut.version>
    <micronaut.runtime>lambda</micronaut.runtime>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>


  <dependencies>

    <!-- CurrentUser + the ResourceNotFoundException family moved here as of
         the Phase 0.5 restructuring (docs/file-storage-plan.md sec 3a) -
         package names are unchanged (andriy.prybaten.security/.error), so
         nothing importing them needed to change, only this new dependency. -->
    <dependency>
      <groupId>andriy.prybaten</groupId>
      <artifactId>common</artifactId>
      <version>0.1</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-events</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-apigateway</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-lambda-events-serde</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-function-aws</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Routes API Gateway events to normal @Controller classes instead of one
         hand-written handler per Lambda. Entry point for deployment is the
         built-in io.micronaut.function.aws.proxy.payload2.APIGatewayV2HTTPEventFunction
         (HTTP API, payload format 2.0) - see docs/architecture.md sec 2/9. -->
    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-function-aws-api-proxy</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Validates the Cognito-issued JWT in-Lambda against the user pool's JWKS.
         Belt-and-braces alongside HTTP API's own Cognito JWT authorizer (which
         rejects bad tokens before Lambda runs): this is what lets a controller
         just `@Inject Authentication` and read the verified `sub` claim, instead
         of us having to reach into the raw APIGatewayV2HTTPEvent authorizer
         context ourselves. See docs/architecture.md sec 2 / open-questions.md #3. -->
    <dependency>
      <groupId>io.micronaut.security</groupId>
      <artifactId>micronaut-security-jwt</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.crac</groupId>
      <artifactId>micronaut-crac</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.serde</groupId>
      <artifactId>micronaut-serde-jackson</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- Storage: DynamoDB for user profile + key/KDF metadata, S3 for the
         whole-vault encrypted blob. See docs/decisions/0001-storage-s3-vs-dynamodb.md
         micronaut-aws-sdk-v2 auto-creates S3Client/DynamoDbClient beans (region,
         credentials, endpoint-override) from `aws.services.<name>.*` config -
         see AwsClientConfig for the one manual bean (DynamoDbEnhancedClient). -->
    <dependency>
      <groupId>io.micronaut.aws</groupId>
      <artifactId>micronaut-aws-sdk-v2</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb-enhanced</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- DynamoDbClient (config/AwsClientConfig.java) is referenced directly in
         our own code, so declare it explicitly rather than relying on it
         arriving transitively via dynamodb-enhanced - that transitive path
         resolved fine via Maven CLI but not via IntelliJ's importer. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.test</groupId>
      <artifactId>micronaut-test-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Local dev/test: run against LocalStack instead of real AWS. These auto-start
         a LocalStack container and resolve aws.services.s3.endpoint-override /
         aws.services.dynamodb.endpoint-override (+ aws.access-key-id/secret-key/region)
         for the micronaut-aws-sdk-v2 client beans above - no code-level env branching. -->
    <dependency>
      <groupId>io.micronaut.testresources</groupId>
      <artifactId>micronaut-test-resources-localstack-s3</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.micronaut.testresources</groupId>
      <artifactId>micronaut-test-resources-localstack-dynamodb</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.micronaut.maven</groupId>
        <artifactId>micronaut-maven-plugin</artifactId>
        <configuration>
<configurationValidation>
    <enabled>false</enabled>

    <suppressions>
        <suppression>datasources.default.db-type</suppression>
    </suppressions>
    <failOnNotPresent>true</failOnNotPresent>
    <validateDependencyInjection>false</validateDependencyInjection>
    <cacheEnabled>true</cacheEnabled>

</configurationValidation>

        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Uncomment to enable incremental compilation -->
          <!-- <useIncrementalCompilation>false</useIncrementalCompilation> -->

          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>io.micronaut.serde</groupId>
              <artifactId>micronaut-serde-processor</artifactId>
              <version>${micronaut.serialization.version}</version>
              <exclusions>
                <exclusion>
                  <groupId>io.micronaut</groupId>
                  <artifactId>micronaut-inject</artifactId>
                </exclusion>
              </exclusions>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amicronaut.processing.group=andriy.prybaten</arg>
            <arg>-Amicronaut.processing.module=smallstash</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>


</project>
